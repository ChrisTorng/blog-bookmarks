{
  "name": "blog-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8788 --infer-origin-from-routes=false",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "check": "node --check src/index.js && node --check src/api.js && node --test tests/*.test.js",
    "deploy": "wrangler deploy",
    "test:integration": "node tests/integration.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}
