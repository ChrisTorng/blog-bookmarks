{
  "name": "blog-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && wrangler dev --local --ip 127.0.0.1 --port 8788 --infer-origin-from-routes=false",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "check": "node scripts/sync-ui.mjs --check && node --test tests/*.test.js",
    "deploy": "npm run build:ui && wrangler deploy",
    "test:integration": "node tests/integration.mjs",
    "build:ui": "node scripts/sync-ui.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}
