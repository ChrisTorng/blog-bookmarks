{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-bookmarks",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-bookmarks",
      "database_id": "fbd20571-62b8-4646-bee6-67d7c5113a7d",
      "migrations_dir": "migrations",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "SITE_URL": "https://christorng.idv.tw",
    "BLOG_SHELL_URL":"https://christorng.idv.tw/notes-shell/",
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://christorng.cloudflareaccess.com",
    "ACCESS_AUD": ""
  }
}
