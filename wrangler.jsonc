{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-bookmarks",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-bookmarks",
      "database_id": "fbd20571-62b8-4646-bee6-67d7c5113a7d",
      "migrations_dir": "migrations",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "SITE_URL": "https://christorng.idv.tw",
    "BLOG_SHELL_URL":"https://christorng.idv.tw/notes-shell/",
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://christorng.cloudflareaccess.com",
    "ACCESS_AUD": "6b0e80ebc88296549323cf796dbfa719bff9f95c26601da07ef5fd67ed696453"
  },
  "routes": [
    {"pattern":"christorng.idv.tw/bookmarks/api*","zone_id":"c5475506538ba09563cacc12b8acb3d0"},
    {"pattern":"christorng.idv.tw/bookmarks/*","zone_id":"c5475506538ba09563cacc12b8acb3d0"},
    {"pattern":"christorng.idv.tw/bookmarks/sitemap.xml*","zone_id":"c5475506538ba09563cacc12b8acb3d0"},
    {"pattern":"christorng.idv.tw/bookmarks/feed.xml*","zone_id":"c5475506538ba09563cacc12b8acb3d0"}
  ]
}
