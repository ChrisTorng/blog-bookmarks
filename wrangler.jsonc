{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-bookmarks",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-bookmarks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://christorng.idv.tw",
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://christorng.cloudflareaccess.com",
    "ACCESS_AUD": ""
  }
}
